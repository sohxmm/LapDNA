{
  "$defs": {
    "AnalysisSummary": {
      "additionalProperties": false,
      "properties": {
        "categories": {
          "items": {
            "$ref": "#/$defs/CornerClassSummary"
          },
          "maxItems": 3,
          "minItems": 3,
          "title": "Categories",
          "type": "array"
        },
        "classification_rule": {
          "const": "reference_apex_minimum_v1",
          "title": "Classification Rule",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9_-]{1,100}$",
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "high_from_kph": {
          "minimum": 0,
          "title": "High From Kph",
          "type": "number"
        },
        "limitations": {
          "items": {
            "maxLength": 600,
            "minLength": 1,
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "medium_from_kph": {
          "minimum": 0,
          "title": "Medium From Kph",
          "type": "number"
        },
        "pattern": {
          "enum": [
            "high_medium_gain_low_loss",
            "mixed",
            "insufficient"
          ],
          "title": "Pattern",
          "type": "string"
        },
        "pattern_driver": {
          "anyOf": [
            {
              "enum": [
                "A",
                "B"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Pattern Driver"
        },
        "text": {
          "maxLength": 600,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "categories",
        "classification_rule",
        "medium_from_kph",
        "high_from_kph",
        "pattern",
        "pattern_driver",
        "text",
        "evidence_ids",
        "limitations"
      ],
      "title": "AnalysisSummary",
      "type": "object"
    },
    "ChannelProvenance": {
      "additionalProperties": false,
      "description": "An aligned display signal must originate in its named native source channel.",
      "properties": {
        "reason": {
          "anyOf": [
            {
              "maxLength": 600,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reason"
        },
        "source_channel": {
          "anyOf": [
            {
              "maxLength": 600,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source Channel"
        },
        "status": {
          "enum": [
            "measured",
            "missing"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "status",
        "source_channel",
        "reason"
      ],
      "title": "ChannelProvenance",
      "type": "object"
    },
    "ChannelProvenanceSet": {
      "additionalProperties": false,
      "properties": {
        "brake": {
          "$ref": "#/$defs/ChannelProvenance"
        },
        "gear": {
          "$ref": "#/$defs/ChannelProvenance"
        },
        "speed_kph": {
          "$ref": "#/$defs/ChannelProvenance"
        },
        "throttle_pct": {
          "$ref": "#/$defs/ChannelProvenance"
        }
      },
      "required": [
        "speed_kph",
        "throttle_pct",
        "gear",
        "brake"
      ],
      "title": "ChannelProvenanceSet",
      "type": "object"
    },
    "ComparisonArtifact": {
      "additionalProperties": false,
      "properties": {
        "analysis": {
          "$ref": "#/$defs/AnalysisSummary"
        },
        "channel_provenance_a": {
          "$ref": "#/$defs/ChannelProvenanceSet"
        },
        "channel_provenance_b": {
          "$ref": "#/$defs/ChannelProvenanceSet"
        },
        "channels_a": {
          "$ref": "#/$defs/DriverChannels"
        },
        "channels_b": {
          "$ref": "#/$defs/DriverChannels"
        },
        "comparison_id": {
          "pattern": "^[A-Za-z0-9_-]{1,100}$",
          "title": "Comparison Id",
          "type": "string"
        },
        "corners": {
          "items": {
            "$ref": "#/$defs/CornerMarker"
          },
          "title": "Corners",
          "type": "array"
        },
        "delta_ms": {
          "items": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Delta Ms",
          "type": "array"
        },
        "detail_level": {
          "const": "telemetry",
          "title": "Detail Level",
          "type": "string"
        },
        "distance_m": {
          "items": {
            "minimum": 0,
            "type": "number"
          },
          "maxItems": 5000,
          "minItems": 2,
          "title": "Distance M",
          "type": "array"
        },
        "estimated_minisectors": {
          "items": {
            "$ref": "#/$defs/EstimatedMiniSector"
          },
          "title": "Estimated Minisectors",
          "type": "array"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/MetricEvidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "geometry": {
          "$ref": "#/$defs/TrackGeometry"
        },
        "insufficient_evidence_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Insufficient Evidence Reason"
        },
        "lap_a": {
          "$ref": "#/$defs/LapMetadata"
        },
        "lap_b": {
          "$ref": "#/$defs/LapMetadata"
        },
        "observations": {
          "items": {
            "$ref": "#/$defs/Observation"
          },
          "maxItems": 3,
          "title": "Observations",
          "type": "array"
        },
        "pairing": {
          "$ref": "#/$defs/PairingContext"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "quality": {
          "$ref": "#/$defs/QualityReport"
        },
        "schema_version": {
          "default": "1.2.0",
          "enum": [
            "1.2.0",
            "1.3.0"
          ],
          "title": "Schema Version",
          "type": "string"
        },
        "sector_boundaries_m": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "minimum": 0,
              "type": "number"
            }
          ],
          "title": "Sector Boundaries M",
          "type": "array"
        },
        "segments": {
          "items": {
            "$ref": "#/$defs/Segment"
          },
          "title": "Segments",
          "type": "array"
        },
        "session": {
          "$ref": "#/$defs/SessionIdentity"
        },
        "valid": {
          "items": {
            "type": "boolean"
          },
          "title": "Valid",
          "type": "array"
        }
      },
      "required": [
        "comparison_id",
        "session",
        "lap_a",
        "lap_b",
        "pairing",
        "detail_level",
        "provenance",
        "distance_m",
        "channels_a",
        "channels_b",
        "channel_provenance_a",
        "channel_provenance_b",
        "geometry",
        "delta_ms",
        "valid",
        "sector_boundaries_m",
        "quality",
        "segments",
        "corners",
        "estimated_minisectors",
        "analysis",
        "evidence",
        "observations",
        "insufficient_evidence_reason"
      ],
      "title": "ComparisonArtifact",
      "type": "object"
    },
    "CornerClassSummary": {
      "additionalProperties": false,
      "properties": {
        "a_wins": {
          "minimum": 0,
          "title": "A Wins",
          "type": "integer"
        },
        "assessment": {
          "enum": [
            "insufficient",
            "mixed",
            "balanced",
            "a_advantage",
            "b_advantage"
          ],
          "title": "Assessment",
          "type": "string"
        },
        "b_wins": {
          "minimum": 0,
          "title": "B Wins",
          "type": "integer"
        },
        "distance_coverage": {
          "maximum": 1,
          "minimum": 0,
          "title": "Distance Coverage",
          "type": "number"
        },
        "evidence_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9_-]{1,100}$",
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "excluded_segment_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9_-]{1,100}$",
            "type": "string"
          },
          "title": "Excluded Segment Ids",
          "type": "array"
        },
        "gains_a_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Gains A Ms"
        },
        "gains_b_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Gains B Ms"
        },
        "included_segment_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9_-]{1,100}$",
            "type": "string"
          },
          "title": "Included Segment Ids",
          "type": "array"
        },
        "independent_units": {
          "minimum": 0,
          "title": "Independent Units",
          "type": "integer"
        },
        "net_gain_ms": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Net Gain Ms"
        },
        "neutral_units": {
          "minimum": 0,
          "title": "Neutral Units",
          "type": "integer"
        },
        "sensitivity": {
          "anyOf": [
            {
              "$ref": "#/$defs/GainSensitivity"
            },
            {
              "type": "null"
            }
          ]
        },
        "speed_class": {
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "title": "Speed Class",
          "type": "string"
        }
      },
      "required": [
        "speed_class",
        "included_segment_ids",
        "excluded_segment_ids",
        "independent_units",
        "distance_coverage",
        "gains_a_ms",
        "gains_b_ms",
        "net_gain_ms",
        "a_wins",
        "b_wins",
        "neutral_units",
        "sensitivity",
        "assessment",
        "evidence_ids"
      ],
      "title": "CornerClassSummary",
      "type": "object"
    },
    "CornerMarker": {
      "additionalProperties": false,
      "properties": {
        "distance_m": {
          "minimum": 0,
          "title": "Distance M",
          "type": "number"
        },
        "label": {
          "maxLength": 600,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "marker_id": {
          "pattern": "^[A-Za-z0-9_-]{1,100}$",
          "title": "Marker Id",
          "type": "string"
        },
        "number": {
          "minimum": 1,
          "title": "Number",
          "type": "integer"
        },
        "reference_speed_kph": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reference Speed Kph"
        },
        "segment_id": {
          "pattern": "^[A-Za-z0-9_-]{1,100}$",
          "title": "Segment Id",
          "type": "string"
        },
        "speed_class": {
          "enum": [
            "low",
            "medium",
            "high",
            "unknown"
          ],
          "title": "Speed Class",
          "type": "string"
        }
      },
      "required": [
        "marker_id",
        "number",
        "label",
        "distance_m",
        "segment_id",
        "reference_speed_kph",
        "speed_class"
      ],
      "title": "CornerMarker",
      "type": "object"
    },
    "DistanceScale": {
      "additionalProperties": false,
      "properties": {
        "integrated_length_m": {
          "exclusiveMinimum": 0,
          "title": "Integrated Length M",
          "type": "number"
        },
        "scale_factor": {
          "exclusiveMinimum": 0,
          "title": "Scale Factor",
          "type": "number"
        }
      },
      "required": [
        "integrated_length_m",
        "scale_factor"
      ],
      "title": "DistanceScale",
      "type": "object"
    },
    "DriverChannels": {
      "additionalProperties": false,
      "description": "Null means unsupported; brake is a switch, never a pressure value.",
      "properties": {
        "brake": {
          "items": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Brake",
          "type": "array"
        },
        "gear": {
          "items": {
            "anyOf": [
              {
                "maximum": 8,
                "minimum": 0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Gear",
          "type": "array"
        },
        "speed_kph": {
          "items": {
            "anyOf": [
              {
                "minimum": 0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Speed Kph",
          "type": "array"
        },
        "throttle_pct": {
          "items": {
            "anyOf": [
              {
                "maximum": 100,
                "minimum": 0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Throttle Pct",
          "type": "array"
        },
        "time_raw_ms": {
          "items": {
            "anyOf": [
              {
                "minimum": 0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Time Raw Ms",
          "type": "array"
        }
      },
      "required": [
        "speed_kph",
        "throttle_pct",
        "gear",
        "brake",
        "time_raw_ms"
      ],
      "title": "DriverChannels",
      "type": "object"
    },
    "EstimatedMiniSector": {
      "additionalProperties": false,
      "properties": {
        "end_m": {
          "minimum": 0,
          "title": "End M",
          "type": "number"
        },
        "gain_ms": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Gain Ms"
        },
        "source": {
          "const": "derived_telemetry",
          "title": "Source",
          "type": "string"
        },
        "start_m": {
          "minimum": 0,
          "title": "Start M",
          "type": "number"
        }
      },
      "required": [
        "source",
        "start_m",
        "end_m",
        "gain_ms"
      ],
      "title": "EstimatedMiniSector",
      "type": "object"
    },
    "GainSensitivity": {
      "additionalProperties": false,
      "properties": {
        "maximum_ms": {
          "title": "Maximum Ms",
          "type": "number"
        },
        "minimum_ms": {
          "title": "Minimum Ms",
          "type": "number"
        }
      },
      "required": [
        "minimum_ms",
        "maximum_ms"
      ],
      "title": "GainSensitivity",
      "type": "object"
    },
    "LapMetadata": {
      "additionalProperties": false,
      "properties": {
        "compound": {
          "title": "Compound",
          "type": "string"
        },
        "driver_code": {
          "pattern": "^[A-Z0-9]{2,4}$",
          "title": "Driver Code",
          "type": "string"
        },
        "driver_name": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Driver Name",
          "type": "string"
        },
        "driver_number": {
          "pattern": "^[0-9]{1,3}$",
          "title": "Driver Number",
          "type": "string"
        },
        "lap_id": {
          "pattern": "^[A-Za-z0-9_-]{1,100}$",
          "title": "Lap Id",
          "type": "string"
        },
        "lap_number": {
          "minimum": 1,
          "title": "Lap Number",
          "type": "integer"
        },
        "lap_start_utc": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lap Start Utc"
        },
        "lap_time_ms": {
          "exclusiveMinimum": 0,
          "title": "Lap Time Ms",
          "type": "number"
        },
        "phase": {
          "enum": [
            "Q1",
            "Q2",
            "Q3"
          ],
          "title": "Phase",
          "type": "string"
        },
        "sector_times_ms": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "exclusiveMinimum": 0,
              "type": "number"
            }
          ],
          "title": "Sector Times Ms",
          "type": "array"
        },
        "team_colour": {
          "anyOf": [
            {
              "pattern": "^#[0-9A-Fa-f]{6}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Team Colour"
        },
        "team_name": {
          "anyOf": [
            {
              "maxLength": 600,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Team Name"
        },
        "track_status": {
          "title": "Track Status",
          "type": "string"
        },
        "tyre_life_laps": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Tyre Life Laps"
        }
      },
      "required": [
        "lap_id",
        "phase",
        "driver_code",
        "driver_name",
        "driver_number",
        "lap_number",
        "lap_time_ms",
        "sector_times_ms",
        "compound",
        "tyre_life_laps",
        "track_status"
      ],
      "title": "LapMetadata",
      "type": "object"
    },
    "MetricEvidence": {
      "additionalProperties": false,
      "properties": {
        "difference_b_minus_a": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Difference B Minus A"
        },
        "difference_interval_b_minus_a": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Difference Interval B Minus A"
        },
        "end_m": {
          "minimum": 0,
          "title": "End M",
          "type": "number"
        },
        "evidence_id": {
          "pattern": "^[A-Za-z0-9_-]{1,100}$",
          "title": "Evidence Id",
          "type": "string"
        },
        "interval_a": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Interval A"
        },
        "interval_b": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Interval B"
        },
        "max_support_span_ms_a": {
          "minimum": 0,
          "title": "Max Support Span Ms A",
          "type": "number"
        },
        "max_support_span_ms_b": {
          "minimum": 0,
          "title": "Max Support Span Ms B",
          "type": "number"
        },
        "metric": {
          "enum": [
            "segment_gain",
            "minimum_speed",
            "entry_speed",
            "exit_speed",
            "brake_onset",
            "throttle_pickup",
            "full_throttle_fraction",
            "gear_at_marker"
          ],
          "title": "Metric",
          "type": "string"
        },
        "native_samples_a": {
          "minimum": 0,
          "title": "Native Samples A",
          "type": "integer"
        },
        "native_samples_b": {
          "minimum": 0,
          "title": "Native Samples B",
          "type": "integer"
        },
        "start_m": {
          "minimum": 0,
          "title": "Start M",
          "type": "number"
        },
        "unit": {
          "enum": [
            "ms",
            "km/h",
            "m",
            "%",
            "gear"
          ],
          "title": "Unit",
          "type": "string"
        },
        "value_a": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value A"
        },
        "value_b": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value B"
        }
      },
      "required": [
        "evidence_id",
        "metric",
        "unit",
        "start_m",
        "end_m",
        "value_a",
        "value_b",
        "difference_b_minus_a",
        "native_samples_a",
        "native_samples_b",
        "max_support_span_ms_a",
        "max_support_span_ms_b"
      ],
      "title": "MetricEvidence",
      "type": "object"
    },
    "Observation": {
      "additionalProperties": false,
      "properties": {
        "evidence_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9_-]{1,100}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        },
        "observation_id": {
          "pattern": "^[A-Za-z0-9_-]{1,100}$",
          "title": "Observation Id",
          "type": "string"
