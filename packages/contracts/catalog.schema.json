{
  "$defs": {
    "ComparisonSummary": {
      "additionalProperties": false,
      "properties": {
        "comparison_id": {
          "pattern": "^[A-Za-z0-9_-]{1,100}$",
          "title": "Comparison Id",
          "type": "string"
        },
        "detail_level": {
          "enum": [
            "telemetry",
            "sector_only"
          ],
          "title": "Detail Level",
          "type": "string"
        },
        "lap_a": {
          "$ref": "#/$defs/LapMetadata"
        },
        "lap_b": {
          "$ref": "#/$defs/LapMetadata"
        },
        "quality_status": {
          "enum": [
            "pass",
            "warn",
            "block"
          ],
          "title": "Quality Status",
          "type": "string"
        },
        "session": {
          "$ref": "#/$defs/SessionIdentity"
        }
      },
      "required": [
        "comparison_id",
        "detail_level",
        "session",
        "lap_a",
        "lap_b",
        "quality_status"
      ],
      "title": "ComparisonSummary",
      "type": "object"
    },
    "LapMetadata": {
      "additionalProperties": false,
      "properties": {
        "compound": {
          "title": "Compound",
          "type": "string"
        },
        "driver_code": {
          "pattern": "^[A-Z0-9]{2,4}$",
          "title": "Driver Code",
          "type": "string"
        },
        "driver_name": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Driver Name",
          "type": "string"
        },
        "driver_number": {
          "pattern": "^[0-9]{1,3}$",
          "title": "Driver Number",
          "type": "string"
        },
        "lap_id": {
          "pattern": "^[A-Za-z0-9_-]{1,100}$",
          "title": "Lap Id",
          "type": "string"
        },
        "lap_number": {
          "minimum": 1,
          "title": "Lap Number",
          "type": "integer"
        },
        "lap_time_ms": {
          "exclusiveMinimum": 0,
          "title": "Lap Time Ms",
          "type": "number"
        },
        "phase": {
          "enum": [
            "Q1",
            "Q2",
            "Q3"
          ],
          "title": "Phase",
          "type": "string"
        },
        "sector_times_ms": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "exclusiveMinimum": 0,
              "type": "number"
            }
          ],
          "title": "Sector Times Ms",
          "type": "array"
        },
        "track_status": {
          "title": "Track Status",
          "type": "string"
        },
        "tyre_life_laps": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Tyre Life Laps"
        }
      },
      "required": [
        "lap_id",
        "phase",
        "driver_code",
        "driver_name",
        "driver_number",
        "lap_number",
        "lap_time_ms",
        "sector_times_ms",
        "compound",
        "tyre_life_laps",
        "track_status"
      ],
      "title": "LapMetadata",
      "type": "object"
    },
    "SessionIdentity": {
      "additionalProperties": false,
      "properties": {
        "circuit_id": {
          "enum": [
            "monza",
            "silverstone",
            "suzuka"
          ],
          "title": "Circuit Id",
          "type": "string"
        },
        "event_name": {
          "maxLength": 150,
          "minLength": 1,
          "title": "Event Name",
          "type": "string"
        },
        "round": {
          "maximum": 30,
          "minimum": 1,
          "title": "Round",
          "type": "integer"
        },
        "session_id": {
          "pattern": "^[A-Za-z0-9_-]{1,100}$",
          "title": "Session Id",
          "type": "string"
        },
        "session_type": {
          "const": "Q",
          "default": "Q",
          "title": "Session Type",
          "type": "string"
        },
        "year": {
          "maximum": 2100,
          "minimum": 2018,
          "title": "Year",
          "type": "integer"
        }
      },
      "required": [
        "session_id",
        "year",
        "round",
        "circuit_id",
        "event_name"
      ],
      "title": "SessionIdentity",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "comparisons": {
      "items": {
        "$ref": "#/$defs/ComparisonSummary"
      },
      "title": "Comparisons",
      "type": "array"
    },
    "schema_version": {
      "const": "1.1.0",
      "default": "1.1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "comparisons"
  ],
  "title": "Catalog",
  "type": "object"
}
