{
  "name": "lapdna",
  "version": "0.1.0",
  "private": true,
  "description": "Distance-aligned Formula 1 qualifying lap analysis",
  "workspaces": ["apps/web"],
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "dev": "npm run dev --workspace @lapdna/web",
    "build": "npm run build --workspace @lapdna/web",
    "typecheck": "npm run typecheck --workspace @lapdna/web",
    "test:web": "node --test apps/web/src/features/comparison/*.test.mjs apps/web/src/features/navigation/*.test.mjs apps/web/src/features/results/*.test.mjs apps/web/src/features/theme/*.test.mjs",
    "contracts": "node scripts/contracts.mjs",
    "contracts:check": "node scripts/contracts.mjs --check"
  },
  "devDependencies": { "openapi-typescript": "7.13.0" }
}
